{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigboard.example.invalid/contracts/config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pigboard-config/v1"
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credential_kind": {
              "const": "atlassian_scoped_service_account_token"
            },
            "cloud_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "secret_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[\\x21-\\x7e]+$"
            }
          },
          "required": [
            "credential_kind",
            "cloud_id",
            "secret_reference"
          ]
        },
        "read_bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_epics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_streams": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_known_issues": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_comments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "max_total_response_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "request_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "scan_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "max_epics",
            "max_streams",
            "max_known_issues",
            "max_comments",
            "max_pages",
            "max_requests",
            "page_size",
            "max_response_bytes",
            "max_total_response_bytes",
            "request_timeout_ms",
            "scan_timeout_ms"
          ]
        }
      },
      "required": [
        "site"
      ]
    },
    "defaults": {
      "$ref": "#/$defs/mappings"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "key": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "board_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "inherit": {
            "type": "array",
            "items": {
              "enum": [
                "stages",
                "accepted_later_stage_ids",
                "types",
                "actors",
                "repositories",
                "worker_prefixes",
                "opt_in_label",
                "preparation_stage_ids",
                "cancelled_stage_ids"
              ]
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "mappings": {
            "$ref": "#/$defs/mappings"
          }
        },
        "required": [
          "id",
          "key",
          "board_ids",
          "inherit",
          "mappings"
        ]
      }
    }
  },
  "required": [
    "schema",
    "jira",
    "defaults",
    "projects"
  ],
  "$defs": {
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Ready to Work": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "In Progress": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "In Review": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "QA": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "Human Review": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "Rework Queued": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "Blocked": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            }
          },
          "required": [
            "Ready to Work",
            "In Progress",
            "In Review",
            "QA",
            "Human Review",
            "Rework Queued",
            "Blocked"
          ]
        },
        "accepted_later_stage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "epic": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "story": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "bug": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            }
          },
          "required": [
            "epic",
            "story",
            "bug"
          ]
        },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manager": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "implementer": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "reviewer": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "qa": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "human_request": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "manager",
            "implementer",
            "reviewer",
            "qa",
            "human_request"
          ]
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "worker_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^\\S+-$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "opt_in_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^\\S+$"
        },
        "preparation_stage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "cancelled_stage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": []
    }
  }
}
