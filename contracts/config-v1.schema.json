{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigboard.example.invalid/contracts/config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pigboard-config/v1"
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credential_kind": {
              "const": "atlassian_scoped_service_account_token"
            },
            "cloud_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "secret_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[\\x21-\\x7e]+$"
            }
          },
          "required": [
            "credential_kind",
            "cloud_id",
            "secret_reference"
          ]
        },
        "read_bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_epics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_streams": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_known_issues": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_comments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "max_total_response_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "request_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "scan_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "max_epics",
            "max_streams",
            "max_known_issues",
            "max_comments",
            "max_pages",
            "max_requests",
            "page_size",
            "max_response_bytes",
            "max_total_response_bytes",
            "request_timeout_ms",
            "scan_timeout_ms"
          ]
        }
      },
      "required": [
        "site"
      ]
    },
    "defaults": {
      "$ref": "#/$defs/mappings"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "key": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "board_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "inherit": {
            "type": "array",
            "items": {
              "enum": [
                "stages",
                "accepted_later_stage_ids",
                "types",
                "actors",
                "repositories",
                "worker_prefixes",
                "opt_in_label",
                "preparation_stage_ids",
                "cancelled_stage_ids"
              ]
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "mappings": {
            "$ref": "#/$defs/mappings"
          }
        },
        "required": [
          "id",
          "key",
          "board_ids",
          "inherit",
          "mappings"
        ]
      }
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "domain_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "account_id": {
              "type": "string",
              "pattern": "^[0-9]{12}$"
            },
            "region": {
              "type": "string",
              "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
            },
            "stack_name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
            },
            "operator_role_arn": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]{1,128}$"
            },
            "deployer_role_arn": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]{1,128}$"
            }
          },
          "required": [
            "account_id",
            "region",
            "stack_name",
            "operator_role_arn",
            "deployer_role_arn"
          ]
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "preview",
                "apply"
              ]
            },
            "schedule_enabled": {
              "type": "boolean"
            },
            "writes_enabled": {
              "type": "boolean"
            },
            "maintenance": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "schedule_enabled",
            "writes_enabled",
            "maintenance"
          ]
        },
        "schedule_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "invocation_timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 900
        },
        "log_retention_days": {
          "enum": [
            1,
            3,
            5,
            7,
            14,
            30,
            60,
            90,
            120,
            150,
            180,
            365,
            400,
            545,
            731,
            1096,
            1827,
            2192,
            2557,
            2922,
            3288,
            3653
          ]
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "full_visibility_confirmed": {
              "type": "boolean"
            },
            "sole_admitting_installation_confirmed": {
              "type": "boolean"
            },
            "inventory_reviewed": {
              "type": "boolean"
            }
          },
          "required": [
            "full_visibility_confirmed",
            "sole_admitting_installation_confirmed",
            "inventory_reviewed"
          ]
        },
        "transition_edges": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "project_id": {
                "type": "string",
                "pattern": "^[0-9]{1,255}$"
              },
              "transition_id": {
                "type": "string",
                "pattern": "^[0-9]{1,255}$"
              },
              "source_status_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{1,255}$"
                }
              },
              "target_status_id": {
                "type": "string",
                "pattern": "^[0-9]{1,255}$"
              },
              "global": {
                "type": "boolean"
              }
            },
            "required": [
              "project_id",
              "transition_id",
              "source_status_ids",
              "target_status_id",
              "global"
            ]
          }
        }
      },
      "required": [
        "installation_id",
        "domain_id",
        "aws",
        "controls",
        "schedule_minutes",
        "invocation_timeout_seconds",
        "log_retention_days",
        "activation",
        "transition_edges"
      ]
    }
  },
  "required": [
    "schema",
    "jira",
    "defaults",
    "projects"
  ],
  "$defs": {
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Ready to Work": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "In Progress": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "In Review": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "QA": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "Human Review": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "Rework Queued": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "Blocked": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            }
          },
          "required": [
            "Ready to Work",
            "In Progress",
            "In Review",
            "QA",
            "Human Review",
            "Rework Queued",
            "Blocked"
          ]
        },
        "accepted_later_stage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "epic": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "story": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            },
            "bug": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 255
            }
          },
          "required": [
            "epic",
            "story",
            "bug"
          ]
        },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manager": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "implementer": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "reviewer": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "qa": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "human_request": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "manager",
            "implementer",
            "reviewer",
            "qa",
            "human_request"
          ]
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "worker_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^\\S+-$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "opt_in_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^\\S+$"
        },
        "preparation_stage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "cancelled_stage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 255
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": []
    }
  }
}
