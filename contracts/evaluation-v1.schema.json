{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigboard.dev/contracts/evaluation-v1.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/campaign"
    },
    {
      "$ref": "#/$defs/packet"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "outcome": {
      "enum": [
        "COMPLETED_CHANGE",
        "BLOCKED",
        "DEPENDENCY_WAIT"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "digest",
        "description"
      ]
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "revision",
        "digest"
      ]
    },
    "assertionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "behavior",
            "integrity"
          ]
        },
        "must_pass": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "must_pass"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "split": {
          "enum": [
            "smoke",
            "development",
            "confirmation"
          ]
        },
        "fixture": {
          "$ref": "#/$defs/digest"
        },
        "task": {
          "$ref": "#/$defs/digest"
        },
        "grader": {
          "$ref": "#/$defs/digest"
        },
        "rubric": {
          "$ref": "#/$defs/digest"
        },
        "expected_outcome": {
          "$ref": "#/$defs/outcome"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "min_successes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "graders_required": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertionSpec"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "id",
        "split",
        "fixture",
        "task",
        "grader",
        "rubric",
        "expected_outcome",
        "repetitions",
        "min_successes",
        "graders_required",
        "assertions",
        "dimensions"
      ]
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "pigboard-evaluation-campaign/v1"
        },
        "kind": {
          "enum": [
            "synthetic_control",
            "model"
          ]
        },
        "unit": {
          "enum": [
            "skill",
            "system"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "baseline": {
          "$ref": "#/$defs/suite"
        },
        "candidate": {
          "$ref": "#/$defs/suite"
        },
        "profile": {
          "$ref": "#/$defs/identity"
        },
        "environment": {
          "$ref": "#/$defs/identity"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            }
          },
          "required": [
            "wall_ms",
            "tokens"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "schema",
        "kind",
        "unit",
        "description",
        "baseline",
        "candidate",
        "profile",
        "environment",
        "limits",
        "cases"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suite": {
          "$ref": "#/$defs/digest"
        },
        "profile": {
          "$ref": "#/$defs/digest"
        },
        "environment": {
          "$ref": "#/$defs/digest"
        },
        "fixture": {
          "$ref": "#/$defs/digest"
        },
        "task": {
          "$ref": "#/$defs/digest"
        },
        "grader": {
          "$ref": "#/$defs/digest"
        },
        "rubric": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "suite",
        "profile",
        "environment",
        "fixture",
        "task",
        "grader",
        "rubric"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "INCOMPLETE"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "required": [
        "id",
        "result",
        "evidence"
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "required": [
        "id",
        "score",
        "applicable",
        "reason",
        "evidence"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "id",
        "path",
        "digest"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/id"
        },
        "profile_verified": {
          "type": "boolean"
        },
        "budgets_enforced": {
          "type": "boolean"
        },
        "receipt": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "actor",
        "profile_verified",
        "budgets_enforced",
        "receipt"
      ]
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "independent": {
          "type": "boolean"
        },
        "report": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "independent",
        "report"
      ]
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "pigboard-evaluation-packet/v1"
        },
        "campaign": {
          "$ref": "#/$defs/digest"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "case": {
          "$ref": "#/$defs/id"
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "arm": {
          "enum": [
            "baseline",
            "candidate"
          ]
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "INCOMPLETE",
            "BUDGET_EXHAUSTED",
            "INFRASTRUCTURE_FAILURE"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/host"
            },
            {
              "type": "null"
            }
          ]
        },
        "graders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grader"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "author_verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "result": {
              "enum": [
                "PASS",
                "FAIL",
                "INCOMPLETE",
                "NOT_APPLICABLE"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/evidenceRefs"
            }
          },
          "required": [
            "result",
            "evidence"
          ]
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "quality": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "wall_ms",
            "tokens"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "schema",
        "campaign",
        "run_id",
        "case",
        "repetition",
        "arm",
        "binding",
        "status",
        "outcome",
        "result_revision",
        "host",
        "graders",
        "author_verification",
        "assertions",
        "quality",
        "metrics",
        "evidence"
      ]
    }
  }
}
