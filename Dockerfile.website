FROM golang:1.26.6-bookworm AS build
WORKDIR /src
COPY website/go.mod ./
COPY website/server/handler.go ./server/
COPY website/cmd/site/main.go ./cmd/site/
RUN CGO_ENABLED=0 go build -trimpath -o /pigboard-site ./cmd/site

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /pigboard-site /usr/local/bin/pigboard-site
COPY dist/website-image/ /site/
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["pigboard-site", "-listen", ":8080", "-site", "/site"]
