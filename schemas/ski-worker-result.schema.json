{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["completed", "blocked", "no-op", "needs-human", "failed"]
    },
    "nextStatus": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "blocker": {
      "type": ["string", "null"]
    },
    "details": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "preserveWorkerType": {
      "type": "boolean"
    },
    "mergeWhenApprovedAndClean": {
      "type": "boolean",
      "description": "Only pr-babysitter may set this true when asking the harness to merge an approved, clean PR before moving it to QA."
    }
  }
}
