meta {
  name: reconcile
  type: http
  seq: 2
}

post {
  url: {{base}}/rest/api/3/search/jql
  body: json
  auth: none
}

headers {
  Authorization: {{jira_auth}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {{search_body}}
}

script:pre-request {
  if (bru.getVar("binding").observation !== "reconcile") throw new Error("PROBE_SELECTOR_MISMATCH");
}

tests {
  const b = bru.getVar("binding");
  test("complete reconciled issue", function () {
    expect(res.getStatus()).to.equal(200);
    const d = res.getBody();
    expect(d.isLast).to.equal(true);
    expect(d.nextPageToken == null).to.equal(true);
    expect(d.issues).to.have.lengthOf(1);
    expect(d.issues[0].id).to.equal(b.issue_id);
    expect(d.issues[0].fields.project.id).to.equal(b.project_id);
    expect(d.issues[0].fields.status.id).to.equal(b.expected.status_id);
  });
}

settings {
  followRedirects: false
  maxRedirects: 0
  timeout: 10000
}
