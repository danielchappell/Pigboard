{
  "github": {
    "owner": "your-github-user-or-org",
    "ownerType": "auto",
    "projectNumber": 1,
    "repositories": ["owner/repo"],
    "ownerApprovers": ["your-github-login"],
    "handoffAuthorLogin": "your-github-login"
  },
  "repositories": {
    "owner/repo": {
      "repository": "owner/repo",
      "cwd": "/absolute/path/to/local/repo",
      "defaultBaseBranch": "main",
      "setupCommands": [],
      "verifyCommands": ["npm test"],
      "setupNetwork": "off",
      "verifyNetwork": "off",
      "allowPushBranches": true,
      "allowCreatePr": true
    }
  },
  "slots": [
    {
      "type": "implementation-planner",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "rolePath": "agents/implementation-planner.md",
      "count": 1,
      "repository": "owner/repo",
      "leaseSeconds": 1800
    },
    {
      "type": "implementer",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "count": 1,
      "repository": "owner/repo",
      "leaseSeconds": 1800
    },
    {
      "type": "reviewer",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "count": 1,
      "repository": "owner/repo",
      "leaseSeconds": 1800
    },
    {
      "type": "pr-babysitter",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "count": 1,
      "repository": "owner/repo",
      "leaseSeconds": 1800
    }
  ]
}
