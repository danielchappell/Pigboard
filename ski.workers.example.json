{
  "github": {
    "owner": "your-github-user-or-org",
    "ownerType": "auto",
    "projectNumber": 1,
    "repositories": ["owner/repo"]
  },
  "repositories": {
    "owner/repo": {
      "repository": "owner/repo",
      "cwd": "/absolute/path/to/local/repo",
      "defaultBaseBranch": "main",
      "setupCommands": [],
      "verifyCommands": ["npm test"],
      "setupNetwork": "off",
      "verifyNetwork": "off",
      "allowPushBranches": true,
      "allowCreatePr": true,
      "allowMerge": false,
      "mergeMethod": "squash"
    }
  },
  "slots": [
    {
      "type": "implementer",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "count": 1,
      "repository": "owner/repo",
      "leaseSeconds": 1800
    },
    {
      "type": "reviewer",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "count": 1,
      "repository": "owner/repo",
      "leaseSeconds": 1800
    },
    {
      "type": "pr-babysitter",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "count": 1,
      "repository": "owner/repo",
      "leaseSeconds": 1800
    }
  ]
}
